---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { path } from '../../lib/url';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'),
);
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <section class="wrap panel">
    <h1 class="page-title">标签</h1>
    <p class="page-desc">共 {tags.length} 个标签，{posts.length} 篇文章。</p>

    {
      tags.length === 0 ? (
        <p class="post-desc">还没有任何标签。</p>
      ) : (
        <div class="tags">
          {tags.map(([tag, count]) => (
            <a class="tag" href={path(`/tags/${tag}/`)}>
              {tag}
              <span class="tag-count">{count}</span>
            </a>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
